GEMINI_API_KEY=replace_with_server_side_key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Opcional. Na Vercel (same-origin) deixe vazio — o servidor aceita apenas Origin same-origin.
# Defina explicitamente só se a API for chamada a partir de outra origem.
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=production
